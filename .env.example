# Application Configuration
APP_NAME=tenancy-service

PORT=3002
NODE_ENV=development
API_DOMAIN=localhost
API_VERSION=1.0.0
ENABLE_DOCUMENTATION=true
LOG_LEVEL=debug

# Authentication (access tokens issued by Identity-Service, verified locally)
JWKS_URL=http://localhost:3001/api/v1/.well-known/jwks.json
JWT_ISSUER=rentify-identity
JWT_AUDIENCE=rentify-api
# Shared secret for internal/* service-to-service endpoints (empty = disabled)
SERVICE_TOKEN=

# Peer services (internal HTTP GET, sent with SERVICE_TOKEN; empty URL = calls fail with 503)
IDENTITY_SERVICE_URL=http://identity:3001
INTERNAL_HTTP_TIMEOUT_MS=3000

# Geocoding (TrackAsia) — key stays in the backend only; empty key = Building create fails with 503
TRACKASIA_API_KEY=
TRACKASIA_BASE_URL=https://maps.track-asia.com
TRACKASIA_TIMEOUT_MS=3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tenancy_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenancy_db
DB_SSL=false
ENABLE_ORM_LOGS=true
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenancy_db

# RabbitMQ Message Broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=pbl6.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_PREFETCH=10
RABBITMQ_CONNECT_TIMEOUT_MS=10000
RABBITMQ_PUBLISH_MANDATORY=true
RABBITMQ_CONSUMER_MAX_ATTEMPTS=5
RABBITMQ_CONSUMER_RETRY_DELAY_MS=10000

# Transactional Outbox
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_PUBLISH_TIMEOUT_MS=5000
OUTBOX_CLAIM_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_RETENTION_MS=604800000
